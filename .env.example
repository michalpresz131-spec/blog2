# Copy to .env and change these values. The app uses SQLite locally unless
# both Turso variables are set.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Configure both values to use Turso/libSQL. Do not commit credentials.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Email notifications. Console backend is convenient for local development.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_TIMEOUT=5
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL="AllManiac blog <noreply@example.com>"
MODERATION_NOTIFICATION_EMAILS=

# Optional AWS SES email delivery. For Render Free, use this HTTPS backend
# instead of SMTP; verify the sender address in SES and keep credentials out
# of this file.
# DJANGO_EMAIL_BACKEND=blog.email_backends.SesEmailBackend
# AWS_SES_REGION_NAME=eu-west-1
# AWS_SES_FROM_EMAIL=verified-sender@example.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# NOTIFY_EMAIL=moderator@gmail.com

# Media defaults to local ./media. Set MEDIA_STORAGE_BACKEND=s3 to use an
# S3-compatible service (credentials are read from standard AWS environment
# variables; no cloud credentials belong in this file).
MEDIA_STORAGE_BACKEND=local
MEDIA_ROOT=media
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
